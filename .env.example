POSTGRES_DB=pulseos
POSTGRES_USER=pulseos
POSTGRES_PASSWORD=generate-locally-do-not-commit
WEB_PORT=3000
PULSEOS_AUTH_ENABLED=false
PULSEOS_REGISTRATION_ENABLED=false
# Generate independently and keep private. Required only when staff signup/login enabled.
PULSEOS_AUTH_JWT_SECRET_BASE64=
PULSEOS_REGISTRATION_INVITE_CODE=

# API only. Off until explicitly enabled and demo recipient allowlist is configured.
PULSEOS_APPOINTMENT_REMINDERS_ENABLED=false
